<Window x:Class="FileCompressor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Compressor"
        Height="450"
        Width="800">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="File Compressor"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <Button Content="Select Image"
                    Width="150"
                    Height="40"
                    Command="{Binding SelectFileCommand}" />

            <TextBlock Text="{Binding SelectedFileName}"
                       Margin="0,15,0,5"
                       TextWrapping="Wrap" />

            <ComboBox Width="200"
                      Height="35"
                      Margin="0,10,0,10"
                      SelectedValuePath="Content"
                      SelectedValue="{Binding SelectedCompressionMode}">
                <ComboBoxItem Content="Maximum Quality" />
                <ComboBoxItem Content="Balanced" />
                <ComboBoxItem Content="Maximum Compression" />
            </ComboBox>

            <Button Content="Compress Image"
                    Width="150"
                    Height="40"
                    Margin="0,10,0,0"
                    Command="{Binding CompressCommand}" />

            <TextBlock Text="{Binding CompressionResult}"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>